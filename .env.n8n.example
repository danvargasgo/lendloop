# Copy to .env.n8n. It is read by docker-compose and never committed.

# The shared key used to sign requests in both directions. Generate one with: openssl rand -hex 32
# Set the same value on the Convex deployment: npx convex env set WEBHOOK_SECRET <value>
WEBHOOK_SECRET=

# Optional: a Slack or Discord compatible webhook for the error workflow. Enable its last node in n8n to use it.
# ALERT_WEBHOOK_URL=
